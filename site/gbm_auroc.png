            "folder_label vs died_ever  : 100.0% match\n",
            "folder_label vs died_30day : 99.5% match\n",
            "\n",
            "473 folder='died' patients did NOT die within 30 days of their last operation:\n"
          ]
        },
        {
          "data": {
            "application/vnd.google.colaboratory.intrinsic+json": {
