      "source": [
        "print('Step 2-3: univariate screen with FDR correction...')\n",
        "res_df = fsp.univariate_screen(fs_df, all_features)\n",
        "sig_features = res_df[res_df.p_value_fdr < 0.05].feature.tolist()\n",
        "print(f\"  {len(sig_features)} of {len(all_features)} features are FDR-significant\")\n",
        "res_df.sort_values('p_value').head(15)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 18,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "KsY9BNN1STX4",
        "outputId": "f47c1c90-9a38-4bc6-d6f0-a1267ff447cb"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Step 4: removing redundant (highly correlated) features...\n",
            "  dropped as redundant: ['alt', 'be', 'gcs_m', 'hct', 'seg', 'total_protein']\n",
            "  40 features remain\n",
            "  28 features remain after the coverage filter\n"
          ]
        }
      ],
      "source": [
        "print('Step 4: removing redundant (highly correlated) features...')\n",
        "pruned_features, dropped = fsp.drop_redundant_features(fs_df, sig_features, res_df)\n",
        "print(f\"  dropped as redundant: {sorted(dropped)}\")\n",
        "print(f\"  {len(pruned_features)} features remain\")\n",
        "\n",
        "# also drop features with poor coverage\n",
        "coverage = {f: max((fs_df[f\"{f}__last\"].notna() & (fs_df.label == 1)).mean(),\n",
        "                    (fs_df[f\"{f}__last\"].notna() & (fs_df.label == 0)).mean())\n",
        "            for f in pruned_features}\n",
        "pruned_features = [f for f in pruned_features if coverage[f] >= 0.10]\n",
        "print(f\"  {len(pruned_features)} features remain after the coverage filter\")\n"
      ]
    },
